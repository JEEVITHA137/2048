mport './App.css';\nimport { IoMdUndo, IoMdRefresh } from \"react-icons/io\";\n\nconst BEST_KEY = '2048-best';\n\nconst readBest = () => {\n  try {\n    return Number(window.localStorage.getItem(BEST_KEY)) || 0;\n  } catch (e) {\n    return 0;\n  }\n};\n\nconst writeBest = (value) => {\n  try {\n    window.localStorage.setItem(BEST_KEY, String(value));\n  } catch (e) {\n    /* storage unavailable — best score stays in memory only */\n  }\n};\n\nconst shuffleArray =(array) =>  array.sort(() => Math.random() - 0.5);\nconst findValue =(num) =>\n{\n  let i=0;\n  while(num > 0)\n  {\n    num = Math.floor(num / 2);\n    i = i+1;\n  }\n  \n  return i-1;\n}\n\nconst ValueBox = ({value,change,temp,swipe}) => { \n  if(value === null)\n  return null;\n    const arr = [\"#2b1f45\",\"#332253\",\"#3b2662\",\"#432a70\",\"#4b2e80\",\"#54328f\",\"#5d369f\",\"#663ab0\",\"#713fc2\",\"#7d45d6\",\"#9c27ff\"];\n    let tran ;\n    if(change)\n    {\n      tran = \"grow 0.4s\"\n    }\n    else if(value!==temp)\n    {\n       if(swipe === \"left\")\n       {\n          tran=\"right 0.1s\"\n       }\n       else if(swipe === \"right\")\n       {\n          tran=\"left 0.1s\"\n       }\n       else if(swipe === \"up\")\n       {\n          tran=\"down 0.1s\"\n       }\n       else if(swipe === \"down\")\n       {\n          tran=\"up 0.1s\"\n       }\n    }\n    let index = findValue(value)\n    return (\n    <div className=\"cellvalues\" style={{backgroundColor:arr[Math.min(index, arr.length) - 1],animation:tran}}>{value}</div>\n    )\n}\nclass App extends Component{\n\n  state = {\n  initialX : null,\n  initialY : null,\n   values : [\n    {value: null},\n    {value: null},\n    {value: null},\n    {value: null},\n    {value: null},\n    {value: null},\n    {value: null},\n    {value: null},\n    {value: null},\n    {value: null},\n    {value: null},\n    {value: null},\n    {value: null},\n    {value: null},\n    {value: null},\n    {value: null}\n  ],\n  tempValues : [\n    {value: null}